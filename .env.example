# Backend (FastAPI). Leave SUPABASE_* empty to use the in-memory store locally.
# Bare project URL, e.g. https://abcdefghijkl.supabase.co (no /rest/v1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PROOF_SIGNING_SECRET=change-me-openssl-rand-hex-32
APP_DOMAIN=earnsure.vercel.app
BANK_PROVIDER=dummy
EXPLANATION_PROVIDER=template
DEMO_SEED_TOKENS=true

# Sign-in (Google via Supabase Auth + authenticator-app MFA).
# false: sign-in and MFA screens are skippable dummies; anonymous demo sessions.
# true:  real sign-in; needs the Google provider set up in Supabase, migration
#        002_auth_user.sql, and the publishable (anon) key below.
AUTH_ENABLED=false
AUTH_REQUIRE_MFA=true
SUPABASE_ANON_KEY=
